{
  "name": "@lumeland/cms",
  "version": "1.0.0",
  "description": "A framework-agnostic CMS",
  "homepage": "https://lume.land/cms/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/lume/cms.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./mod.d.ts",
      "import": "./mod.js"
    },
    "./*.js": {
      "types": "./*.d.ts",
      "import": "./*.js"
    },
    "./*.ts": {
      "types": "./*.d.ts",
      "import": "./*.js"
    }
  },
  "dependencies": {
    "deno-std": "^1.6.0",
    "sharp": "^0.35.5",
    "temporal-polyfill": "^1.0.6",
    "ventojs": "^2.4.2"
  }
}