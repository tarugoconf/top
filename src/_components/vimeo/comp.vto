<figure
  id="{{ block.id }}"
  class="block-vimeo theme is-light box-fill no-padding width-full"
>
  <top-vimeo id="vimeo_{{ block.code }}" data-id="{{ block.code }}">
    <img src="{{ block.cover }}" alt="{{ block.alt }}">
  </top-vimeo>

  {{ if block.caption }}
    <figcaption>
      {{ block.caption |> md }}
    </figcaption>
  {{ /if }}
</figure>
